{
    "name": "opencop-dev",
    "private": true,
    "version": "0.0.0",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=22.23.4 <23 || >=24.22.1 <25",
        "npm": ">=11.13.0 <12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.23.4 <23 || >=24.22.1 <25",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=11.13.0 <12",
            "onFail": "error"
        }
    },
    "//": "See DEPENDENCY-OVERRIDES.md for rationale on overrides",
    "overrides": {
        "handlebars": "4.7.10",
        "fflate": "0.8.3",
        "@chakra-ui/cli": {
            "zod": "$zod"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "./docker-build.sh",
        "vite:build": "tsc -b && vite build",
        "typecheck": "tsc -b --noEmit",
        "lint": "eslint .",
        "check:no-leak": "node scripts/check-no-premium-leak.mjs",
        "check:doc-links": "node scripts/check-doc-links.mjs",
        "chakra": "npx chakra typegen $(npm prefix)/packages/ui/src/theme/theme.ts",
        "test": "vitest",
        "test:sidc-generator": "node --test scripts/generate-sidc-catalog.test.mjs",
        "test:doc-links": "node --test scripts/check-doc-links.test.mjs",
        "test:browser": "vitest run --config vitest.browser.config.ts",
        "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css}\"",
        "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,css}\"",
        "playwright": "playwright test",
        "playwright:ui": "playwright test --ui",
        "playwright:debug": "playwright test --debug",
        "playwright:report": "playwright show-report",
        "playwright:cli": "playwright cli",
        "playwright:trace": "playwright show-trace",
        "playwright:setup-data": "playwright test --project=setup-data",
        "playwright:setup-users": "playwright test --project=setup-data e2e/setup/06-users.spec.ts",
        "playwright:setup-bulk": "E2E_BULK=1 playwright test --project=setup-data e2e/setup/10-bulk-layers-groups.spec.ts",
        "test:historical-data": "cd ../backend && ./mvnw -f processor/pom.xml test -Dtest='HistoricalSimulationTest#generateHistoricalSourceData' -DfailIfNoTests=false \"-DargLine=-Djunit.jupiter.conditions.deactivate=org.junit.*DisabledCondition\"",
        "proto:elements:js": "npx pbjs -t static-module -w es6 -o $(npm prefix)/packages/proto/src/ts/elements.js $(npm prefix)/packages/proto/src/elements.proto",
        "proto:message:js": "npx pbjs -t static-module -w es6 -o $(npm prefix)/packages/proto/src/ts/message.js $(npm prefix)/packages/proto/src/message.proto",
        "proto:elements:patch": "npx replace-in-file /@exports/g '@name' $(npm prefix)/packages/proto/src/ts/elements.js --verbose",
        "proto:message:patch": "npx replace-in-file /@exports/g '@name' $(npm prefix)/packages/proto/src/ts/message.js --verbose",
        "proto:elements:ts": "npx pbts -w es6 -o $(npm prefix)/packages/proto/src/ts/elements.d.ts $(npm prefix)/packages/proto/src/ts/elements.js",
        "proto:message:ts": "npx pbts -w es6 -o $(npm prefix)/packages/proto/src/ts/message.d.ts $(npm prefix)/packages/proto/src/ts/message.js",
        "proto:elements:build": "npm run proto:elements:js && npm run proto:elements:patch && npm run proto:elements:ts",
        "proto:message:build": "npm run proto:message:js && npm run proto:message:patch && npm run proto:message:ts",
        "proto:chunk:js": "npx pbjs -t static-module -w es6 -o $(npm prefix)/packages/proto/src/ts/chunk.js $(npm prefix)/packages/proto/src/elements.proto $(npm prefix)/packages/proto/src/chunk.proto",
        "proto:chunk:patch": "npx replace-in-file /@exports/g '@name' $(npm prefix)/packages/proto/src/ts/chunk.js --verbose",
        "proto:chunk:ts": "npx pbts -w es6 -o $(npm prefix)/packages/proto/src/ts/chunk.d.ts $(npm prefix)/packages/proto/src/ts/chunk.js",
        "proto:chunk:build": "npm run proto:chunk:js && npm run proto:chunk:patch && npm run proto:chunk:ts",
        "proto:build": "npm run proto:elements:build && npm run proto:message:build && npm run proto:chunk:build",
        "symbology:generate-catalog": "node scripts/generate-sidc-catalog.mjs",
        "postinstall": "patch-package && npm run chakra",
        "prepare": "husky",
        "i18n:extract": "i18next-cli extract",
        "i18n:check": "i18next-cli extract --ci",
        "i18n:completeness": "node scripts/check-i18n-completeness.js",
        "ci:lint": "node scripts/junit-wrap.mjs --name lint --out test-results/junit-lint.xml -- bash scripts/check-lint-baseline.sh",
        "ci:i18n": "node scripts/junit-wrap.mjs --name i18n --out test-results/junit-i18n.xml -- npm run i18n:check",
        "ci:i18n-completeness": "node scripts/junit-wrap.mjs --name i18n-completeness --out test-results/junit-i18n-completeness.xml -- npm run i18n:completeness",
        "ci:i18n-seq": "run-s --continue-on-error ci:i18n ci:i18n-completeness",
        "ci:script-tests": "node scripts/junit-wrap.mjs --name script-tests --out test-results/junit-script-tests.xml -- bash scripts/derive-app-version-test.sh",
        "ci:sidc-generator": "node scripts/junit-wrap.mjs --name sidc-generator --out test-results/junit-sidc-generator.xml -- npm run test:sidc-generator",
        "ci:audit-critical": "node scripts/junit-wrap.mjs --name audit-critical --out test-results/junit-audit-critical.xml -- node scripts/check-npm-audit-allowlist.js --audit-level=high --omit=dev",
        "ci:audit-advisory": "node scripts/junit-wrap.mjs --name audit-advisory --nonblocking --out test-results/junit-audit-advisory.xml -- npm audit --audit-level=moderate",
        "ci:junit-wrap": "node scripts/junit-wrap.mjs --name junit-wrap --out test-results/junit-junit-wrap.xml -- node --test scripts/junit-wrap.test.mjs",
        "ci:no-leak-calibration": "node scripts/junit-wrap.mjs --name no-leak-calibration --out test-results/junit-no-leak-calibration.xml -- node --test scripts/check-no-premium-leak.test.mjs",
        "ci:doc-links": "node scripts/junit-wrap.mjs --name doc-links --out test-results/junit-doc-links.xml -- npm run check:doc-links",
        "ci:doc-links-tests": "node scripts/junit-wrap.mjs --name doc-links-tests --out test-results/junit-doc-links-tests.xml -- npm run test:doc-links",
        "ci:checks": "run-p --continue-on-error --print-label ci:lint ci:i18n-seq ci:script-tests ci:sidc-generator ci:audit-critical ci:audit-advisory ci:junit-wrap ci:no-leak-calibration ci:doc-links ci:doc-links-tests",
        "perf": "playwright test --config e2e/perf/perf.config.ts",
        "perf:profiling": "PERF_PROFILING=1 playwright test --grep @profiling --config e2e/perf/perf.config.ts",
        "perf:browse": "npx tsx e2e/perf/helpers/report-server.ts",
        "perf:stop": "kill $(lsof -t -i :4001)"
    },
    "lint-staged": {
        "//": "bash -c prevents lint-staged from appending staged file paths — extraction must scan the full codebase. Locale JSON formatting is owned by i18next-cli (indentation/sort), not prettier.",
        "packages/**/*.{ts,tsx}": [
            "bash -c 'i18next-cli extract'"
        ],
        "packages/**/*.{ts,tsx,js,jsx,json,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@ark-ui/react": "5.37.2",
        "@armyc2.c5isr.renderer/mil-sym-ts-web": "^2.8.3",
        "@chakra-ui/charts": "3.36.1",
        "@chakra-ui/react": "3.36.1",
        "@deck.gl/core": "9.3.1",
        "@deck.gl/extensions": "9.3.1",
        "@deck.gl/geo-layers": "9.3.1",
        "@deck.gl/layers": "9.3.1",
        "@deck.gl/mapbox": "9.3.1",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@emotion/react": "11.14.0",
        "@fontsource-variable/inter": "5.2.8",
        "@fontsource-variable/jetbrains-mono": "5.2.8",
        "@hookform/resolvers": "^5.2.2",
        "@tanstack/react-pacer": "^0.20.0",
        "@tanstack/react-query": "5.90.20",
        "@tanstack/react-table": "8.21.3",
        "@tanstack/react-virtual": "^3.13.24",
        "@turf/turf": "7.2.0",
        "@types/maplibre-gl": "1.14.0",
        "@types/pako": "2.0.4",
        "@types/uuid": "10.0.0",
        "assert-never": "1.4.0",
        "deep-diff": "1.0.2",
        "dexie": "^4.4.2",
        "dotenv": "17.2.3",
        "formik": "2.4.6",
        "hls.js": "1.6.16",
        "i18next": "25.8.0",
        "js-logger": "^1.6.1",
        "lodash": "4.18.1",
        "luxon": "3.7.2",
        "maplibre-gl": "5.8.0",
        "mgrs": "^2.1.0",
        "milsymbol": "3.0.3",
        "mpegts.js": "1.8.2",
        "next-themes": "0.4.6",
        "opencc-js": "1.4.2",
        "pako": "2.1.0",
        "papaparse": "^5.5.3",
        "protobufjs": "8.6.6",
        "react": "19.2.7",
        "react-arborist": "^3.4.3",
        "react-avatar-editor": "15.1.0",
        "react-dom": "19.2.7",
        "react-error-boundary": "6.0.0",
        "react-hook-form": "^7.71.2",
        "react-i18next": "16.5.4",
        "react-icons": "^5.5.0",
        "react-map-gl": "8.0.4",
        "react-router": "8.3.0",
        "recharts": "^3.8.1",
        "scroll-into-view-if-needed": "^3.1.0",
        "spin-delay": "^2.0.1",
        "type-fest": "4.41.0",
        "uuid": "^14.0.0",
        "websocket-ts": "2.2.1",
        "yup": "1.7.0",
        "zod": "4.6.6",
        "zustand": "^5.0.12",
        "zustand-multi-persist": "^0.1.4"
    },
    "devDependencies": {
        "@chakra-ui/cli": "3.36.1",
        "@deck.gl/test-utils": "9.3.2",
        "@eslint-react/eslint-plugin": "^2.12.4",
        "@eslint/js": "9.38.0",
        "@faker-js/faker": "10.5.0",
        "@playwright/test": "1.63.0",
        "@tanstack/eslint-plugin-query": "5.91.4",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/deep-diff": "1.0.5",
        "@types/lodash": "4.17.23",
        "@types/luxon": "3.7.1",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "4.6.0",
        "@vitest/browser-playwright": "4.1.12",
        "@vitest/ui": "4.1.12",
        "chart.js": "4.5.1",
        "chartjs-plugin-annotation": "3.1.0",
        "eslint": "9.30.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-formatter-gitlab": "6.0.1",
        "eslint-plugin-boundaries": "5.4.0",
        "eslint-plugin-i18next": "^6.1.3",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-react-refresh": "0.4.20",
        "fake-indexeddb": "6.2.5",
        "fast-xml-parser": "5.7.3",
        "globals": "16.3.0",
        "happy-dom": "21.0.4",
        "husky": "9.1.7",
        "i18next-cli": "^1.51.0",
        "lint-staged": "16.2.7",
        "msw": "2.14.6",
        "npm-run-all2": "8.0.4",
        "patch-package": "8.0.1",
        "prettier": "3.7.4",
        "protobufjs-cli": "2.5.5",
        "replace-in-file": "^8.4.0",
        "tsx": "4.23.1",
        "typescript": "5.9.2",
        "typescript-eslint": "8.46.2",
        "vite": "^7.3.7",
        "vite-plugin-glsl": "1.5.1",
        "vitest": "4.1.12"
    }
}
