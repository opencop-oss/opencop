# Global options - disable features that require write access
# (TLS certificates, config autosave, admin API)
# TLS is terminated by an upstream proxy when TLS is used
{
	auto_https off
	admin off
	persist_config off
}

:80 {
	root * /usr/share/caddy
	encode gzip

	# HTML5 routing: fallback to index.html for react-router pages like /map
	# since we don't use anchors like #map.
	# Invalid API paths (Accept: application/json) will still 404.
	@spa {
		not file
		header Accept *text/html*
	}
	rewrite @spa /index.html

	file_server

	# Cache Vite assets (content-hashed, safe to cache forever)
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Branding assets: not content-hashed, may be overridden by deployers
	@branding path /branding/*
	header @branding Cache-Control "public, max-age=86400"

	# Prevent caching of HTML
	# The index does not have a content hash so should be small and always fetched.
	# The /assets referenced by the index have content caches (are immutable) and
	# can be cached indefinitely.
	@html {
		path *.html /
	}
	header @html Cache-Control "no-cache, no-store, must-revalidate"
}
