# Urls to fetch data from (ideally relative, minimize CORS issues)
VITE_APP_TITLE=OpenCOP
VITE_KEYCLOAK_URL=/auth

VITE_API_BASE_URL=/v1/me

VITE_OPENCOP_CORE_API_URL=/api
VITE_WEBSOCKET_URL=/ws

# Default local reverse-proxy target for development requests.
# Individual service targets can be overridden in .env.development.local.
VITE_DEV_PROXY_TARGET=http://localhost:80
